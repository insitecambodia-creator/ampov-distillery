---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import { img } from '../../data/images';

const items = (await getCollection('actualites')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Actualités" description="Les dernières nouvelles, annonces et publications médiatiques concernant Ampov : innovations, engagements et présence dans les événements.">
  <section class="section">
    <div class="wrap">
      <h1>Actualités</h1>
      <p class="lead">Retrouvez ici les dernières nouvelles et annonces d’Ampov. <a href="/actualites/dans-la-presse/">Voir aussi : Ampov dans la presse →</a></p>
      <div class="grid">
        {items.map((a) => {
          const link = a.body?.trim() ? `/actualite/${a.id}/` : undefined;
          const Tag = link ? 'a' : 'div';
          return (
            <Tag class="card" href={link}>
              {a.data.image && img(a.data.image) && <Pic path={a.data.image} alt="" widths={[320, 480, 640]} sizes="(min-width: 60rem) 20rem, 90vw" />}
              <div class="body">
                <h3>{a.data.title}</h3>
                {a.data.excerpt && <p class="meta">{a.data.excerpt}</p>}
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </section>
</Base>
