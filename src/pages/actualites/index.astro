---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

// Blog : du plus récent au plus ancien ; le plus récent est mis en avant.
const posts = (await getCollection('actualites')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [latest, ...older] = posts;
---
<Base title="Actualités" description="Les dernières nouvelles, annonces et événements d’Ampov Distillery : dégustations, festivals, partenariats et vie de la distillerie.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Le blog</p>
      <h1>Actualités</h1>
      <p class="lead">Les dernières nouvelles d’Ampov : événements, dégustations, rencontres et vie de la distillerie.</p>
      {latest && <PostCard post={latest} featured />}
      {older.length > 0 && <div class="grid posts">{older.map((p) => <PostCard post={p} />)}</div>}
      <p class="foot">Retrouvez aussi les articles qui parlent de nous : <a href="/actualites/dans-la-presse/">Ampov dans la presse</a>.</p>
    </div>
  </section>
</Base>
<style>
  .posts { margin-top: 2rem; }
  .foot { margin-top: 3rem; color: var(--muted); }
</style>
