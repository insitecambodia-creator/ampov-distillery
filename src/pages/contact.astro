---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const { address } = site;
const hasAddress = address.street || address.city;
---
<Base title="Contact" description="Contactez Ampov Distillery : adresse, e-mail, téléphone.">
  <section class="section">
    <div class="wrap prose">
      <h1>Contact</h1>
      <p>Une question, une visite, une commande professionnelle ? Écrivez-nous.</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      {site.phone && <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>}
      {hasAddress && (
        <address>
          {address.street}<br />{address.postalCode} {address.city}<br />{address.country}
        </address>
      )}
      <!-- TODO: formulaire (Formspree / Web3Forms / Netlify Forms) si souhaité -->
    </div>
  </section>
</Base>
