---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate } from '../../data/format';
import { site } from '../../data/site';

// Seuls les articles dont le corps Markdown est renseigné ont une page (URL WordPress conservée : /actualite/<slug>/).
export async function getStaticPaths() {
  const all = (await getCollection('actualites')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const published = all.filter((a) => a.body?.trim());
  return published.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, newer: published[i - 1], older: published[i + 1], others: all.filter((a) => a.id !== entry.id).slice(0, 3) },
  }));
}
const { entry, newer, older, others } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const iso = data.date.toISOString().slice(0, 10);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: data.title, datePublished: iso,
  author: { '@type': 'Organization', name: site.legalName }, publisher: { '@type': 'Organization', name: site.legalName },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Base title={data.title} description={data.excerpt || undefined} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="section">
    <div class="wrap narrow">
      <p class="back"><a href="/actualites/">← Toutes les actualités</a></p>
      <p class="date"><time datetime={iso}>{formatDate(data.date)}</time></p>
      <h1>{data.title}</h1>
      {data.image && <div class="cover"><Pic path={data.image} alt="" widths={[640, 960, 1280]} sizes="(min-width: 50rem) 46rem, 100vw" loading="eager" /></div>}
      <div class="prose body"><Content /></div>
      {(newer || older) && (
        <nav class="pager" aria-label="Autres articles">
          {older ? <a href={older.body?.trim() ? `/actualite/${older.id}/` : '/actualites/'}><span>← Précédent</span>{older.data.title}</a> : <span></span>}
          {newer ? <a class="next" href={`/actualite/${newer.id}/`}><span>Suivant →</span>{newer.data.title}</a> : <span></span>}
        </nav>
      )}
    </div>
  </article>
  {others.length > 0 && (
    <section class="section alt">
      <div class="wrap">
        <h2>Autres actualités</h2>
        <div class="grid">{others.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</Base>
<style>
  .narrow { max-width: 50rem; }
  .back { margin: 0 0 1.5rem; }
  .date { margin: 0 0 .5rem; font: 600 .9rem var(--display); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  h1 { text-transform: none; font-size: clamp(2.2rem, 5vw, 3.4rem); letter-spacing: .01em; }
  .cover { margin: 1.5rem 0 2rem; }
  .cover :global(img) { width: 100%; height: auto; }
  .body { max-width: none; font-size: 1.12rem; }
  .body :global(img) { margin-block: 1.5rem; }
  .pager { display: flex; justify-content: space-between; gap: 1.5rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .pager a { text-decoration: none; max-width: 22rem; font-weight: 600; }
  .pager a span { display: block; font: 600 .85rem var(--display); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .2rem; }
  .pager .next { text-align: right; margin-left: auto; }
</style>
