---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Pic from '../../components/Pic.astro';

// Seuls les articles dont le corps Markdown est renseigné ont une page
// (URL conservée : /actualite/<slug>/).
export async function getStaticPaths() {
  const all = await getCollection('actualites');
  return all.filter((a) => a.body?.trim()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.excerpt || undefined} ogType="article">
  <article class="section">
    <div class="wrap prose">
      <p class="eyebrow"><a href="/actualites/">← Actualités</a></p>
      <h1>{entry.data.title}</h1>
      {entry.data.image && <Pic path={entry.data.image} alt="" />}
      <Content />
    </div>
  </article>
</Base>
