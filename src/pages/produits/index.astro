---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';

const produits = (await getCollection('produits')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Nos produits" description="La gamme de spiritueux d’Ampov Distillery.">
  <section class="section">
    <div class="wrap">
      <h1>Nos produits</h1>
      <div class="grid">{produits.map((p) => <ProductCard product={p} />)}</div>
    </div>
  </section>
</Base>
