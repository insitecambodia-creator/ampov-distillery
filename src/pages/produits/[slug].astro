---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const produits = await getCollection('produits');
  return produits.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.summary,
  brand: { '@type': 'Brand', name: site.name },
  ...(data.sku && { sku: data.sku }),
};
---
<Base title={data.name} description={data.summary} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="section">
    <div class="wrap layout">
      <div>
        {data.image
          ? <Image src={data.image} alt={data.imageAlt ?? data.name} widths={[480, 800]} sizes="(min-width: 50rem) 30rem, 100vw" loading="eager" />
          : <div class="ph" aria-hidden="true">{data.name}</div>}
      </div>
      <div class="prose">
        <p class="eyebrow">{data.category}</p>
        <h1>{data.name}</h1>
        <p class="lead">{data.summary}</p>
        <dl>
          {data.volumeCl && <><dt>Contenance</dt><dd>{data.volumeCl} cl</dd></>}
          {data.abv && <><dt>Degré</dt><dd>{data.abv} % vol.</dd></>}
        </dl>
        <Content />
        <!-- Emplacement du futur bouton « Ajouter au panier » -->
        <p><a class="btn ghost" href="/produits/">← Tous les produits</a></p>
      </div>
    </div>
  </section>
</Base>
<style>
  .layout { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); align-items: start; }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1.5rem; margin: 0 0 1.5rem; }
  dt { color: var(--muted); } dd { margin: 0; }
</style>
