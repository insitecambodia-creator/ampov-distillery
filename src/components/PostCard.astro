---
import type { CollectionEntry } from 'astro:content';
import Pic from './Pic.astro';
import { img } from '../data/images';
import { formatDate } from '../data/format';

// Carte d'article de blog. Lien actif uniquement si l'article a un corps (page article générée).
interface Props { post: CollectionEntry<'actualites'>; featured?: boolean }
const { post, featured = false } = Astro.props;
const { data } = post;
const href = post.body?.trim() ? `/actualite/${post.id}/` : undefined;
const Tag = href ? 'a' : 'div';
const hasImage = data.image && img(data.image);
---
<Tag class:list={['post', { featured }]} href={href}>
  <div class="media">
    {hasImage
      ? <Pic path={data.image!} alt="" widths={featured ? [640, 960, 1280] : [320, 480, 640]} sizes={featured ? '(min-width: 60rem) 36rem, 100vw' : '(min-width: 60rem) 20rem, 90vw'} loading={featured ? 'eager' : 'lazy'} />
      : <div class="ph" aria-hidden="true">Ampov</div>}
  </div>
  <div class="text">
    <p class="date"><time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date)}</time></p>
    {featured ? <h2>{data.title}</h2> : <h3>{data.title}</h3>}
    {data.excerpt && <p class="excerpt">{data.excerpt}</p>}
    {href && <p class="more">Lire la suite →</p>}
  </div>
</Tag>
<style>
  .post { display: grid; grid-template-rows: auto 1fr; align-content: start; background: var(--bg-alt); border: 1px solid var(--line); text-decoration: none; color: inherit; }
  a.post:hover { border-color: var(--accent); color: inherit; }
  .media :global(img), .ph { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .ph { background: linear-gradient(160deg, #efe5d3, #e4d6bd); display: grid; place-items: center; color: var(--muted); font: 600 1.4rem var(--display); letter-spacing: .3em; text-transform: uppercase; }
  .text { padding: 1.25rem 1.4rem 1.5rem; }
  .date { margin: 0 0 .4rem; font: 600 .82rem var(--display); letter-spacing: .14em; text-transform: uppercase; color: var(--accent); }
  h2, h3 { margin-bottom: .5rem; }
  h3 { font-size: calc(1.45rem - 2px); }
  .excerpt { color: var(--muted); margin: 0 0 .75rem; }
  .more { margin: 0; font: 600 1rem var(--display); letter-spacing: .03em; color: var(--accent); }
  .featured { grid-template-rows: none; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); align-items: stretch; }
  .featured .text { padding: clamp(1.5rem, 4vw, 3rem); align-self: center; }
  .featured h2 { font-size: calc(clamp(1.9rem, 4vw, 2.8rem) - 2px); }
  .featured .excerpt { font-size: 0.975rem; }
  .featured .media :global(img), .featured .ph { aspect-ratio: auto; height: 100%; min-height: 16rem; }
</style>
