---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
interface Props { product: CollectionEntry<'produits'> }
const { product } = Astro.props;
const { data } = product;
const details = [data.volumeCl && `${data.volumeCl} cl`, data.abv && `${data.abv} % vol.`].filter(Boolean).join(' · ');
---
<a class="card" href={`/produits/${product.id}/`}>
  {data.image
    ? <Image src={data.image} alt={data.imageAlt ?? data.name} widths={[320, 480, 640]} sizes="(min-width: 60rem) 16rem, 45vw" class="img" />
    : <div class="ph" aria-hidden="true">{data.name}</div>}
  <div class="body">
    <p class="meta">{data.category}</p>
    <h3>{data.name}</h3>
    <p class="meta">{details}</p>
  </div>
</a>
<style>.img { aspect-ratio: 4/5; object-fit: cover; width: 100%; }</style>
