---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr">
  <div class="wrap bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Navigation principale">
      <ul>
        {nav.map((n) => (
          <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<style>
  .hdr { border-bottom: 1px solid var(--line); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem 2rem; padding-block: 1rem; }
  .brand { font: 600 1.35rem var(--serif); letter-spacing: .08em; text-transform: uppercase; color: var(--fg); text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: .25rem 1.75rem; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); text-decoration: none; padding-block: .35rem; border-bottom: 2px solid transparent; }
  nav a:hover, nav a[aria-current] { color: var(--fg); border-bottom-color: var(--accent); }
</style>
