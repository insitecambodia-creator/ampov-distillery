---
import { decoStyle, type Deco } from '../data/deco';
// Section large à deux colonnes : texte d'un côté, photos de l'autre (slot « media »).
// Sans photos, le texte s'étale sur deux colonnes. `alt` = fond crème plus foncé, `reverse` = photos à gauche,
// `dark` = bandeau vert sombre (texte blanc / doré) pour casser le rythme — à n'utiliser qu'une fois par page.
interface Props { title?: string; level?: 2 | 3; eyebrow?: string; alt?: boolean; dark?: boolean; reverse?: boolean; id?: string; deco?: Deco; decoLeft?: boolean }
const { title, level = 2, eyebrow, alt = false, dark = false, reverse = false, id, deco, decoLeft = false } = Astro.props;
const hasMedia = Astro.slots.has('media');
const Heading = `h${level}` as 'h2' | 'h3';
---
<section class:list={['feature', { alt, dark, reverse, solo: !hasMedia, 'has-deco': deco, 'deco-left': deco && decoLeft }]} id={id} style={deco ? decoStyle(deco) : undefined}>
  <div class="wrap grid">
    <div class="text">
      {title && <Heading>{title}</Heading>}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <slot />
    </div>
    {hasMedia && <div class="media"><slot name="media" /></div>}
  </div>
</section>
<style>
  .feature { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .feature.alt { background: var(--bg-alt); }
  .feature.dark { background: #011a09; color: #fff; }
  .dark .text :global(h2), .dark .text :global(h3), .dark .text :global(strong) { color: #fff; }
  .dark .text :global(.eyebrow) { color: var(--accent-light); }
  .dark .text :global(.ticks li::before) { color: var(--accent-light); }
  .grid { display: grid; gap: clamp(2rem, 5vw, 4.5rem); grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  .reverse .media { order: -1; }
  .text :global(h2) { margin-top: 0; }
  .text :global(h3) { margin-top: 1.5rem; }
  .text :global(p), .text :global(ul) { max-width: 38rem; }
  .text :global(.ticks) { margin-block: .75rem 1.25rem; }
  .media { display: grid; gap: 1rem; }
  .media :global(img) { width: 100%; height: auto; display: block; }
  .media :global(.gallery) { margin-block: 0; }
  .media :global(.video) { margin: 0; }
  .media :global(.cap) { margin: 0; font-size: 1.15rem; }
  /* Sans photo : texte sur deux colonnes, chaque bloc reste entier */
  .solo .grid { grid-template-columns: 1fr; }
  .solo .text { columns: 2 22rem; column-gap: clamp(2rem, 5vw, 4.5rem); }
  .solo .text :global(h2), .solo .text :global(h3) { column-span: all; }
  .solo .text :global(p), .solo .text :global(ul) { max-width: none; break-inside: avoid; }
  @media (max-width: 52rem) {
    .grid { grid-template-columns: 1fr; }
    .reverse .media { order: 0; }
  }
</style>
