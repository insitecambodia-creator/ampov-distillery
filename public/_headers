# Cloudflare Pages — en-têtes HTTP.
# Les URLs de prévisualisation *.pages.dev ne doivent pas être indexées ;
# ces règles ne s'appliquent PAS au domaine ampov-distillery.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Fichiers générés par Astro : nom haché, donc cache d'un an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
