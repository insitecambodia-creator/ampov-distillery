# Endpoint du formulaire de demande de visite (Formspree, Web3Forms, Getform…).
# Laisser vide : le formulaire ouvre le client mail du visiteur.
PUBLIC_FORM_ENDPOINT=

# Indexation par les moteurs de recherche. Laisser vide en préproduction.
# METTRE « true » (variable de build Cloudflare) AU MOMENT DE LA MISE EN LIGNE sur ampov-distillery.com,
# puis relancer un déploiement ; sinon le site restera en noindex.
PUBLIC_INDEXABLE=
